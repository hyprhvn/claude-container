# syntax=docker/dockerfile:1

# ==============================================================================
# 1. BUILDER STAGE: Compiles native binaries and wheels
# ==============================================================================
FROM alpine:3.24 AS builder

RUN --mount=type=cache,target=/var/cache/apk \
    apk add \
        build-base \
        musl-dev \
        rust \
        cargo \
        python3 \
        python3-dev \
        py3-pip \
        cmake

# Build jj-cli with cached cargo registries
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo install --locked --bin jj --root /build/cargo jj-cli

# Pre-compile DuckDB into a reusable wheel
RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --no-deps --wheel-dir=/build/wheels duckdb


# ==============================================================================
# 2. RUNTIME STAGE: Final image without build-time toolchains
# ==============================================================================
FROM docker.io/hyprhvn/claude-container:base

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# System utils
RUN --mount=type=cache,target=/var/cache/apk \
    apk add \
        bash \
        coreutils \
        findutils \
        grep \
        sed \
        gawk \
        procps

# Networking
RUN --mount=type=cache,target=/var/cache/apk \
    apk add \
        iputils \
        iproute2 \
        traceroute \
        mtr \
        iperf \
        conntrack-tools \
        ethtool \
        nmap \
        nmap-ncat \
        socat \
        curl \
        wget \
        bind-tools \
        openssh-client

# Runtimes & build managers
RUN --mount=type=cache,target=/var/cache/apk \
    apk add \
        python3 \
        py3-pip \
        uv \
        openjdk25 \
        maven \
        gradle \
        nodejs \
        npm \
        rust \
        cargo \
        go

# VCS tooling + jj binary copied from builder
RUN --mount=type=cache,target=/var/cache/apk \
    apk add \
        git \
        git-lfs \
        patch \
        patchutils
COPY --from=builder /build/cargo/bin/jj /usr/local/bin/jj

# Headless browser & playwright
RUN --mount=type=cache,target=/var/cache/apk \
    --mount=type=cache,target=/root/.npm \
    apk add \
        chromium \
        font-noto \
        font-noto-cjk \
    && npm install -g playwright

# Documentation tooling
RUN --mount=type=cache,target=/var/cache/apk \
    --mount=type=cache,target=/root/.npm \
    apk add \
        texlive \
        texlive-latexextra \
        texlive-latexrecommended \
        plantuml \
        graphviz \
    && npm install -g @mermaid-js/mermaid-cli

# Agent tooling: Bind mount wheels directly into the install step
RUN --mount=type=cache,target=/var/cache/apk \
    apk add \
        ast-grep \
        ripgrep \
        fd \
        ctags \
        jq \
        yq-go \
        htmlq \
        xmlstarlet \
        miller

RUN --mount=type=bind,from=builder,source=/build/wheels,target=/tmp/wheels \
    --mount=type=cache,target=/root/.cache/pip \
    pip install --break-system-packages \
        /tmp/wheels/* \
        csvkit \
        jc

# Language servers
RUN --mount=type=cache,target=/var/cache/apk \
    --mount=type=cache,target=/root/.npm \
    apk add \
        clang-extra-tools \
        py3-lsp-server \
        jdtls \
        rust-analyzer \
        gopls \
    && npm install -g \
        bash-language-server \
        typescript \
        typescript-language-server

# Claude update
RUN apk upgrade claude-code
