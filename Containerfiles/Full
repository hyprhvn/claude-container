FROM docker.io/hyprhvn/claude-container:base
# add common dev tooling to the Base container

# basic system utils
RUN apk add --no-cache \
        bash \
        coreutils \
        findutils \
        grep \
        sed \
        gawk \
        procps

# networking
RUN apk add --no-cache \
        iputils \
        iproute2 \
        traceroute \
        mtr \
        iperf \
        conntrack-tools \
        ethtool \
        nmap \
        nmap-ncat \
        socat \
        curl \
        wget \
        bind-tools \
        openssh-client

# language support
RUN apk add --no-cache \
        build-base cmake \
        musl-dev \
        python3 python3-dev \
        py3-pip uv \
        openjdk25 \
        maven gradle \
        nodejs \
        npm \
        rust \
        cargo

# 
ENV PATH=$PATH:/root/.cargo/bin

# VCS
RUN apk add --no-cache \
        git \
        git-lfs \
        patch \
        patchutils \
    && cargo install --locked --bin jj jj-cli \
    && rm -rf /root/.cargo/registry /root/.cargo/git

# Prevent playwright from downloading the incompatible glibc Chromium binary
# and set a single source of truth for the browser binary location that can be used in scripts
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    NODE_PATH=/usr/local/lib/node_modules

# Install headless browser and playwright
RUN apk add --no-cache \
        chromium \
        font-noto \
        font-noto-cjk \
    && npm install -g playwright \
    && npm cache clean --force

# Prevent npm/puppeteer from downloading the incompatible glibc Chromium binary
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=$PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH

# doc
RUN apk add --no-cache \
        texlive \
        texlive-latexextra \
        texlive-latexrecommended \
        plantuml \
        graphviz \
    && npm install -g @mermaid-js/mermaid-cli \
    && npm cache clean --force

# agent tooling
RUN apk add --no-cache \
        ast-grep \
        ripgrep \
        fd \
        ctags \
        jq \
        yq-go \
        htmlq \
        xmlstarlet \
        miller \
    && pip install --no-cache-dir --break-system-packages \
        csvkit \
        duckdb \
        jc \
    && rm -rf /tmp/*

# language servers
RUN apk add --no-cache \
        clang-extra-tools \
        py3-lsp-server \
        jdtls \
        rust-analyzer \
    && npm install -g \
        bash-language-server \
        typescript typescript-language-server \
    && npm cache clean --force

# update claude
RUN apk upgrade claude-code
