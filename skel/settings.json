{
	"permissions": {
		"allow": [
			"Bash(apk add *)",
			"Bash(apk update *)",
			"Bash(apk upgrade *)"
		]
	},
	"statusLine": {
		"type": "command",
		"command": "/root/.claude/statusline.sh"
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/root/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	}
}
