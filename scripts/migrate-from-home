#!/usr/bin/env bash

set -eEuo pipefail

# Directories based on XDG Base Directory Specification
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-container"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-container"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-container"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/claude-container"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKEL_DIR="${CLAUDE_CONTAINER_SKEL:-$SCRIPT_DIR/../skel}"

LEGACY_CLAUDE_DIR="${CLAUDE_LEGACY_DIR:-$HOME/.claude}"
LEGACY_CLAUDE_JSON="${CLAUDE_LEGACY_JSON:-$HOME/.claude.json}"

DRY_RUN=false
COPY_ONLY=false
BACKUP=true

usage() {
	local prog
	prog=$(basename "${0}")
	cat <<EOF
NAME
    $prog - Migrate legacy ~/.claude configuration to XDG Base Directories

SYNOPSIS
    $prog [-h | --help] [-n | --dry-run] [-c | --copy] [--no-backup]

DESCRIPTION
    Migrates files from the legacy ~/.claude directory and ~/.claude.json file
    into their corresponding XDG Base Directory locations:
      - Config (CLAUDE.md, settings.json, rules/, skills/, etc.):
        $CONFIG_DIR
      - State (claude.json, agent-memory/):
        $STATE_DIR
      - Cache (projects/ session history & auto-memory):
        $CACHE_DIR
      - Data (external skills / data):
        $DATA_DIR

OPTIONS
    -h, --help       display this help message and exit
    -n, --dry-run    show what would be migrated without making changes
    -c, --copy       copy files instead of moving them
    --no-backup      do not create a timestamped backup before moving
EOF
}

parse_args() {
	while [[ $# -gt 0 ]]; do
		case "${1}" in
		-h | --help)
			usage
			exit 0
			;;
		-n | --dry-run)
			DRY_RUN=true
			;;
		-c | --copy)
			COPY_ONLY=true
			;;
		--no-backup)
			BACKUP=false
			;;
		*)
			echo "Unknown option: ${1}" >&2
			usage
			exit 2
			;;
		esac
		shift
	done
}

log() {
	echo "==> ${*}"
}

ensure_xdg_skeleton() {
	local dirs=(
		"$CONFIG_DIR"
		"$CONFIG_DIR/rules"
		"$CONFIG_DIR/skills"
		"$CONFIG_DIR/themes"
		"$CONFIG_DIR/output-styles"
		"$CONFIG_DIR/agents"
		"$CONFIG_DIR/workflows"
		"$CONFIG_DIR/commands"
		"$DATA_DIR"
		"$DATA_DIR/skills"
		"$STATE_DIR"
		"$STATE_DIR/agent-memory"
		"$CACHE_DIR"
		"$CACHE_DIR/projects"
	)

	for d in "${dirs[@]}"; do
		if $DRY_RUN; then
			echo "[dry-run] mkdir -p \"$d\""
		else
			mkdir -p "$d"
		fi
	done

	# Ensure minimal claude.json state file exists if none present
	local state_json="$STATE_DIR/claude.json"
	if [[ ! -f "$state_json" && ! -f "$LEGACY_CLAUDE_JSON" ]]; then
		if $DRY_RUN; then
			echo "[dry-run] create minimal $state_json"
		else
			echo "{}" >"$state_json"
		fi
	fi
}

migrate_item() {
	local src="${1}"
	local dest="${2}"

	[[ -e "$src" ]] || return 0

	local dest_parent
	dest_parent=$(dirname "$dest")

	if $DRY_RUN; then
		if $COPY_ONLY; then
			echo "[dry-run] cp -a \"$src\" \"$dest\""
		else
			echo "[dry-run] mv \"$src\" \"$dest\""
		fi
		return 0
	fi

	mkdir -p "$dest_parent"

	if [[ -d "$src" && -d "$dest" ]]; then
		cp -a "$src"/. "$dest"/
		if $COPY_ONLY; then
			log "Copied: $src -> $dest"
		else
			rm -rf "$src"
			log "Merged & moved: $src -> $dest"
		fi
	elif $COPY_ONLY; then
		cp -a "$src" "$dest"
		log "Copied: $src -> $dest"
	else
		mv "$src" "$dest"
		log "Moved: $src -> $dest"
	fi
}

seed_from_skeleton() {
	[[ -d "$SKEL_DIR" ]] || return 0

	local mapping=(
		"config:$CONFIG_DIR"
		"data:$DATA_DIR"
		"state:$STATE_DIR"
	)

	for entry in "${mapping[@]}"; do
		local skel_subdir="${entry%%:*}"
		local target_dir="${entry##*:}"
		local src_root="$SKEL_DIR/$skel_subdir"

		[[ -d "$src_root" ]] || continue

		while IFS= read -r -d '' file; do
			local rel="${file#"$src_root"/}"
			local dest="$target_dir/$rel"

			if [[ ! -e "$dest" ]]; then
				if $DRY_RUN; then
					echo "[dry-run] seed $dest from $file"
				else
					mkdir -p "$(dirname "$dest")"
					cp -a "$file" "$dest"
					log "Seeded: $dest (from template)"
				fi
			fi
		done < <(find "$src_root" -mindepth 1 ! -type d -print0)
	done
}

create_backup() {
	if ! $BACKUP || $DRY_RUN || $COPY_ONLY; then
		return 0
	fi

	local timestamp
	timestamp=$(date +%Y%m%d_%H%M%S)
	local backup_dir="$HOME/.claude.backup.$timestamp"

	if [[ -d "$LEGACY_CLAUDE_DIR" || -f "$LEGACY_CLAUDE_JSON" ]]; then
		log "Creating backup in $backup_dir..."
		mkdir -p "$backup_dir"
		if [[ -d "$LEGACY_CLAUDE_DIR" ]]; then
			cp -a "$LEGACY_CLAUDE_DIR" "$backup_dir/.claude"
		fi
		if [[ -f "$LEGACY_CLAUDE_JSON" ]]; then
			cp -a "$LEGACY_CLAUDE_JSON" "$backup_dir/.claude.json"
		fi
		log "Backup complete: $backup_dir"
	fi
}

main() {
	log "Starting XDG Migration for claude-container..."

	if [[ ! -d "$LEGACY_CLAUDE_DIR" && ! -f "$LEGACY_CLAUDE_JSON" ]]; then
		log "No legacy ~/.claude or ~/.claude.json found. Initializing fresh XDG directory skeleton..."
		ensure_xdg_skeleton
		seed_from_skeleton
		log "Initialization complete."
		exit 0
	fi

	ensure_xdg_skeleton
	create_backup

	# 1. State files
	if [[ -f "$LEGACY_CLAUDE_JSON" ]]; then
		migrate_item "$LEGACY_CLAUDE_JSON" "$STATE_DIR/claude.json"
	fi

	if [[ -d "$LEGACY_CLAUDE_DIR/agent-memory" ]]; then
		migrate_item "$LEGACY_CLAUDE_DIR/agent-memory" "$STATE_DIR/agent-memory"
	fi

	# 2. Cache files (projects auto-memory and session cache)
	if [[ -d "$LEGACY_CLAUDE_DIR/projects" ]]; then
		migrate_item "$LEGACY_CLAUDE_DIR/projects" "$CACHE_DIR/projects"
	fi

	# 3. Config files and directories
	local config_files=(
		"CLAUDE.md"
		"settings.json"
		"settings.local.json"
		"keybindings.json"
	)
	for f in "${config_files[@]}"; do
		if [[ -f "$LEGACY_CLAUDE_DIR/$f" ]]; then
			migrate_item "$LEGACY_CLAUDE_DIR/$f" "$CONFIG_DIR/$f"
		fi
	done

	local config_subdirs=(
		"rules"
		"skills"
		"themes"
		"output-styles"
		"agents"
		"workflows"
		"commands"
	)
	for d in "${config_subdirs[@]}"; do
		if [[ -d "$LEGACY_CLAUDE_DIR/$d" ]]; then
			migrate_item "$LEGACY_CLAUDE_DIR/$d" "$CONFIG_DIR/$d"
		fi
	done

	# Seed missing template files that didn't exist in legacy setup (without overwriting migrated files)
	seed_from_skeleton

	# If legacy directory is now empty and not in copy mode, remove it
	if ! $COPY_ONLY && ! $DRY_RUN && [[ -d "$LEGACY_CLAUDE_DIR" ]]; then
		rmdir "$LEGACY_CLAUDE_DIR" 2>/dev/null || {
			log "Note: Some unrecognized files remain in $LEGACY_CLAUDE_DIR."
		}
	fi

	log "Migration finished successfully!"
}

parse_args "${@}"
main
