#!/usr/bin/env bash

set -eEuo pipefail

# update-skel - Seed or update the unified claude-container directory from
# the skel/ templates, with explicit provenance tracking.
#
# Provenance lives in $CC_DIR/.skel-manifest.tsv (rel<TAB>sha256): a file is
# template-managed only while it is listed there and unmodified. Files that
# are untracked or user-modified are never touched, and installed files are
# never deleted, even if the skel stops providing them. Provenance is
# explicit only - there is deliberately no "adopt if the hash matches"
# heuristic, so a lost manifest can at worst make a file look user-managed
# (it is skipped, never clobbered).

CC_DIR="${CLAUDE_CONTAINER_DIR:-$HOME/.local/opt/claude-container}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKEL_DIR="${CLAUDE_CONTAINER_SKEL:-$SCRIPT_DIR/../skel}"
MANIFEST="$CC_DIR/.skel-manifest.tsv"

MODE="seed"
DRY_RUN=false
FORCE_ALL=false
FORCE_PATHS=()

declare -A MANIFEST_HASH=()

usage() {
	local prog indent_length indent
	prog=$(basename "${0}")
	indent_length="${#prog}"
	indent=$(printf "%${indent_length}s")

	# ensure that lines with the prog or indent don't exceed 80 characters!
	cat <<EOF
NAME
    $prog - Seed or update the claude-container directory from skel/

SYNOPSIS
    $prog [-h | --help] [-n | --dry-run] [--seed | --update]
    $indent [--force [SKEL_REL_PATH]]...

DESCRIPTION
    Copies starter files from the skel/ directory into the unified
    claude-container directory, tracking provenance in
    \$CC_DIR/.skel-manifest.tsv (rel<TAB>sha256, only rewritten when it
    changes).

    \$CC_DIR defaults to \$HOME/.local/opt/claude-container, override with
    CLAUDE_CONTAINER_DIR. The skel directory defaults to the repository's
    skel/, override with CLAUDE_CONTAINER_SKEL. skel/test/ holds Test-image
    assets and is never seeded.

    A file is template-managed only while it is in the manifest and
    unmodified; user-modified and untracked files are never touched, and
    installed files are never deleted.

    --seed (default): copy files that do not exist yet. Prints only actions
                     taken - silent in steady state, idempotent and safe to
                     run any number of times.
    --update: as --seed, plus refresh tracked files whose skel template
                     changed (manifest hash no longer matches the skel).
    --force [PATH]: copy the skel file over the destination even if the
                     destination was modified. PATH is a skel-relative path
                     (e.g. settings.json); a bare --force forces all tracked
                     files. Existing destinations are backed up to
                     <dest>.bak.<timestamp> first. Destructive by design.

OPTIONS
    -h, --help       display this help message and exit
    -n, --dry-run    report the actions without making any changes
    --seed           copy-missing-only mode (default)
    --update         refresh tracked files when the skel changed
    --force [PATH]   force PATH (or all tracked files when PATH is
                     omitted). Repeatable. Backs up existing destinations.
EOF
}

parse_args() {
	while [[ $# -gt 0 ]]; do
		case "${1}" in
		-h | --help)
			usage
			exit 0
			;;
		-n | --dry-run)
			DRY_RUN=true
			;;
		--seed)
			MODE="seed"
			;;
		--update)
			MODE="update"
			;;
		--force)
			# lookahead: consume the next argument as a path iff it is not a flag
			if [[ $# -gt 1 && "${2}" != -* ]]; then
				FORCE_PATHS+=("${2}")
				shift
			else
				FORCE_ALL=true
			fi
			;;
		*)
			echo "Unknown option: ${1}" >&2
			usage
			exit 2
			;;
		esac
		shift
	done
}

log() {
	echo "==> ${*}"
}

# report a per-file line
#
# Output discipline is mode-aware: --seed prints only actions taken (silent
# in steady state, so re-runs are quiet); --update and --dry-run also report
# skips, conflicts, and a summary.
report() {
	local msg="${1}"
	local kind="${2:-action}" # action | info

	if $DRY_RUN; then
		echo "[dry-run] ${msg}"
		return 0
	fi
	if [[ "$MODE" == "seed" && "$kind" == "info" ]]; then
		return 0
	fi
	echo "${msg}"
}

file_hash() {
	sha256sum -- "${1}" | awk '{print $1}'
}

load_manifest() {
	[[ -f "$MANIFEST" ]] || return 0
	local rel hash
	while IFS=$'\t' read -r rel hash; do
		[[ -n "$rel" ]] && MANIFEST_HASH["$rel"]="${hash}"
	done <"$MANIFEST"
}

forced_path() {
	local p
	for p in "${FORCE_PATHS[@]}"; do
		[[ "$p" == "$1" ]] && return 0
	done
	return 1
}

# seedable skel files, relative to $SKEL_DIR (skel/test/ is excluded)
skel_files() {
	find "$SKEL_DIR" -mindepth 1 ! -type d ! -path "$SKEL_DIR/test/*" -print0
}

write_manifest() {
	# atomic: build in a temp file, mv over the old one only when changed
	local tmp rel
	tmp=$(mktemp "$MANIFEST.XXXXXX")
	while IFS= read -r rel; do
		[[ -n "$rel" ]] && printf '%s\t%s\n' "$rel" "${new_manifest[$rel]}"
	done < <(printf '%s\n' "${!new_manifest[@]}" | LC_ALL=C sort) >"$tmp"

	if [[ -f "$MANIFEST" ]] && cmp -s "$tmp" "$MANIFEST"; then
		rm -f "$tmp"
	else
		mv "$tmp" "$MANIFEST"
	fi
}

main() {
	parse_args "$@"

	if [[ ! -d "$SKEL_DIR" ]]; then
		echo "ERROR: skel directory not found: $SKEL_DIR" >&2
		echo "       (set CLAUDE_CONTAINER_SKEL to point at the repository's skel/)" >&2
		exit 3
	fi

	local rel
	for rel in "${FORCE_PATHS[@]}"; do
		if [[ ! -f "$SKEL_DIR/$rel" ]]; then
			echo "ERROR: --force path is not a skel file: $rel" >&2
			exit 2
		fi
	done

	if ! $DRY_RUN; then
		mkdir -p "$CC_DIR"
	fi
	load_manifest

	local -A new_manifest=()
	local -A skel_rels=()
	local seeded=0 updated=0 forced=0 user_skips=0 link_skips=0 stale=0
	local f dest skel_hash dest_hash old bak

	while IFS= read -r -d '' f; do
		rel="${f#"$SKEL_DIR"/}"
		skel_rels["$rel"]=1
		dest="$CC_DIR/$rel"
		skel_hash=$(file_hash "$f")

		# 1. forced
		if $FORCE_ALL || forced_path "$rel"; then
			if [[ -L "$dest" ]]; then
				report "Skipped (stow symlink, never replaced): $rel"
				link_skips=$((link_skips + 1))
				continue # manifest entry dropped
			fi
			if [[ -e "$dest" && ! -f "$dest" ]]; then
				report "Skipped (user-managed, not a file): $rel"
				user_skips=$((user_skips + 1))
				continue
			fi
			if [[ -e "$dest" ]]; then
				bak="$dest.bak.$(date +%Y%m%d_%H%M%S)"
				if ! $DRY_RUN; then
					cp -a "$dest" "$bak"
				fi
				report "Forced: $rel (backup: ${bak#"$CC_DIR"/})"
			else
				report "Forced: $rel"
			fi
			if ! $DRY_RUN; then
				mkdir -p "$(dirname "$dest")"
				cp -a "$f" "$dest"
			fi
			new_manifest["$rel"]="$skel_hash"
			forced=$((forced + 1))
			continue
		fi

		# 2. destination is a symlink (stow): never touch, drop provenance
		if [[ -L "$dest" ]]; then
			report "Skipped (stow symlink): $rel"
			link_skips=$((link_skips + 1))
			continue
		fi

		# 3. destination missing: seed
		if [[ ! -e "$dest" ]]; then
			report "Seeded: $rel"
			if ! $DRY_RUN; then
				mkdir -p "$(dirname "$dest")"
				cp -a "$f" "$dest"
			fi
			new_manifest["$rel"]="$skel_hash"
			seeded=$((seeded + 1))
			continue
		fi

		# 4. destination exists but is not a regular file: user-managed
		if [[ ! -f "$dest" ]]; then
			report "Skipped (user-managed, not a file): $rel" info
			user_skips=$((user_skips + 1))
			continue
		fi

		# 5. destination exists: provenance decides
		dest_hash=$(file_hash "$dest")
		old="${MANIFEST_HASH[$rel]:-}"
		if [[ -z "$old" || "$dest_hash" != "$old" ]]; then
			# untracked, or modified since install: user-managed
			report "Skipped (user-managed): $rel" info
			user_skips=$((user_skips + 1))
			continue
		fi
		if [[ "$dest_hash" == "$skel_hash" ]]; then
			# tracked, untouched, skel unchanged: steady state
			new_manifest["$rel"]="$skel_hash"
			continue
		fi
		# tracked, untouched, but the skel template changed
		if [[ "$MODE" == "update" ]]; then
			report "Updated (skel changed): $rel"
			if ! $DRY_RUN; then
				cp -a "$f" "$dest"
			fi
			new_manifest["$rel"]="$skel_hash"
			updated=$((updated + 1))
		else
			report "Skel changed, run --update: $rel"
			stale=$((stale + 1))
			new_manifest["$rel"]="$old"
		fi
	done < <(skel_files)

	# 6. manifest entries whose file is no longer in the skel: report only,
	#    never delete installed files
	for rel in "${!MANIFEST_HASH[@]}"; do
		if [[ -z "${skel_rels[$rel]:-}" ]]; then
			report "No longer in skel, left in place: $rel" info
		fi
	done

	if ! $DRY_RUN; then
		write_manifest
	fi

	if $DRY_RUN || [[ "$MODE" == "update" ]]; then
		log "update-skel: ${seeded} seeded, ${updated} updated, ${forced} forced, ${user_skips} skipped (user-managed), ${link_skips} skipped (symlink), ${stale} stale (skel changed)"
	fi
}

main "$@"
