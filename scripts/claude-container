#!/usr/bin/env bash

set -eEuo pipefail # make bash reasonably strict

trap cleanup EXIT                          # cleanup on exit
trap "exit 126" HUP INT QUIT ABRT TERM ERR # also calls cleanup

# IFS=$'\n\t'

# set -xv  # uncomment for debugging
cleanup() {
	ret_code=$?

	set +eEuo pipefail # make bash act normal after exit
	# set -xv  # uncomment for debugging

	# check if SOCAT_PID exists before killing
	if [[ -n "${SOCAT_PID:-}" ]]; then
		kill "$SOCAT_PID" 2>/dev/null
	fi
	# clean up runtime dir
	rm -rf "$RUNTIME_DIR"

	$VERBOSE && echo "Bye!"

	exit $ret_code
}

# unified claude-container directory: everything Claude needs (config, state,
# cache, data, runtime) lives under one host directory, override with
# CLAUDE_CONTAINER_DIR
CC_DIR="${CLAUDE_CONTAINER_DIR:-$HOME/.local/opt/claude-container}"
RUNTIME_DIR="$CC_DIR/runtime"

# set defaults for flag arguments
VERBOSE=false # TODO use this: https://stackoverflow.com/a/8756552/5994623
MOUNTS=()
EXTRA_SKILLS_DIRS=()
CONTAINER_ARGS=()
CONTAINER_TAG=full

# -v arguments assembled at runtime by add_mount and add_dir_mounts
MOUNT_ARGS=()

# set defaults for positionals
DIR=
CLAUDE_ARGS=()

# define help message
usage() {
	local prog indent_length indent
	prog=$(basename "${0}")
	indent_length="${#prog}"
	indent=$(printf "%${indent_length}s")

	# ensure that lines with the prog or indent don't exceed 80 characters!
	cat <<EOF
NAME
    $prog - Run claude in a container.

SYNOPSIS
    $prog [-h | --help] [-v | --verbose] [-q | --quiet]
    $indent [-m | --mount MOUNT]... [--skills-dir DIR]...
    $indent [-C | --container-arg ARG]...
    $indent [DIR] [CLAUDE_ARGS...]

DESCRIPTION

    This script runs $(printf "\e]8;;https://claude.com/product/claude-code\aclaude-code\e]8;;\a") in a container.

OPTIONS

    Basic Options

        -h, --help               display this help message and exit
        -v, --verbose            print more output (default)
        -q, --quiet              print less output (buggy, do not use!)

    Advanced Options

        -m, --mount MOUNT        mount an additional host path into the
                                 container, in the podman -v syntax,
                                 <from>:<to>[:<options>]. May be given more than
                                 once. <to> defaults to the resolved <from>,
                                 <options> defaults to z. Sources are resolved
                                 through symlinks, targets are used as given.

        --skills-dir DIR         mount additional skills from the specified
                                 directory into /root/.claude/skills. May be
                                 specified multiple times.

        -C, --container-arg ARG  pass an extra flag or argument directly to
                                 the podman container runtime (e.g.
                                 --privileged, --device=/dev/fuse). May be
                                 specified multiple times.

        -t, --tag TAG            the tag of the container to start. Defaults to
								 "full", use "test" for testing and "base" for
								 minimal setup.

    Positional Arguments

        DIR                      the directory in which claude should work
                                 (default is \$PWD)

        CLAUDE_ARGS              optional trailing arguments passed directly to
                                 the claude executable inside the container
                                 (e.g. --help, config, -p "prompt")

EOF
}

# parse arguments
get_opts() {
	while [[ $# -gt 0 ]]; do
		local argument="${1}"
		case "${argument}" in
		# Basic Options
		-h | --help)
			usage
			exit 0
			;;
		-v | --verbose)
			VERBOSE=true # basically a NOOP
			;;
		-q | --quiet)
			VERBOSE=false
			;;
		# Advanced Options
		-m | --mount)
			if [[ $# -lt 2 ]]; then
				echo -e "Missing argument for ${argument}\n"
				usage
				exit 2
			fi
			shift
			MOUNTS+=("${1}")
			;;
		--skills-dir)
			if [[ $# -lt 2 ]]; then
				echo -e "Missing argument for ${argument}\n"
				usage
				exit 2
			fi
			shift
			EXTRA_SKILLS_DIRS+=("${1}")
			;;
		-C | --container-arg)
			if [[ $# -lt 2 ]]; then
				echo -e "Missing argument for ${argument}\n"
				usage
				exit 2
			fi
			shift
			CONTAINER_ARGS+=("${1}")
			;;
		-t | --tag)
			if [[ $# -lt 2 ]]; then
				echo -e "Missing argument for ${argument}\n"
				usage
				exit 2
			fi
			shift
			CONTAINER_TAG="${1}"
			;;
		--) # separator: all subsequent arguments are positionals / claude args
			shift
			if [[ -z $DIR && $# -gt 0 ]]; then
				DIR="${1}"
				shift
			fi
			CLAUDE_ARGS+=("${@}")
			break
			;;
		--*) # unrecognized long flag
			if [[ -n "$DIR" ]]; then
				CLAUDE_ARGS+=("${argument}")
			else
				echo -e "Unknown flag ${argument}\n"
				usage
				exit 2
			fi
			;;
		-*) # unrecognized short flag
			if [[ -n "$DIR" ]]; then
				CLAUDE_ARGS+=("${argument}")
			else
				echo -e "Unknown flag ${argument}\n"
				usage
				exit 2
			fi
			;;
		*) # parse positionals
			if [[ -z $DIR ]]; then
				DIR="${argument}"
			else
				CLAUDE_ARGS+=("${argument}")
			fi
			;;
		esac
		shift
	done
	# set default for DIR if none was passed
	if [[ -z $DIR ]]; then
		DIR="${PWD}"
	fi
	# abort on DIR=~
	if [[ "$DIR" == "$HOME" ]]; then
		echo -e "Unable to use HOME as DIR\n"
		usage
		exit 4
	fi
}

# ensure existence of the unified directory and minimal scaffold
ensure_locations() {
	mkdir -p "$CC_DIR"
	mkdir -p "$CC_DIR"/{skills,plugins,rules,agents,hooks,themes,output-styles,workflows,commands}

	mkdir -p "$RUNTIME_DIR"
	chmod 0700 "$RUNTIME_DIR" 2>/dev/null || true

	# Ensure minimal claude.json exists so podman can bind-mount it as a file
	if [[ ! -f "$CC_DIR/claude.json" ]]; then
		echo "{}" >"$CC_DIR/claude.json"
	fi
}

# Print the fully resolved location of a host path, or fail if there is none
resolve_host_path() {
	local path="${1}"
	local real

	real=$(readlink -f -- "$path" 2>/dev/null) || return 1
	[[ -n "$real" && -e "$real" ]] || return 1

	printf '%s' "$real"
}

# Append a mount of a single host path
#
# The source is resolved through any symlinks, so that a link is mounted as
# whatever it points at rather than as a link into a directory the container
# cannot see. The target keeps the path of the link itself, which leaves
# references between mounted paths intact.
add_mount() {
	local path="${1}"       # host path, may be a symlink
	local target="${2}"     # absolute path inside the container
	local options="${3:-z}" # podman mount options
	local real

	if ! real=$(resolve_host_path "$path"); then
		echo "Skipping ${path}: unresolvable symlink" >&2
		return 0
	fi

	MOUNT_ARGS+=(-v "$real:$target:$options")
}

# Append one mount per entry of a host directory, recursively
#
# Mounting the entries instead of the directory itself keeps symlinked contents
# usable inside the container. Dotfile managers such as stow fill a directory
# with relative symlinks into a package directory, as in
# config -> ../../.dotfiles/git/.config/git/config, and mounting only the
# directory leaves those links dangling, because their targets are not mounted
# along with it. Resolving each entry also bounds what the container sees to
# what the directory really holds.
#
# Entries resolving outside of both the directory and HOME are skipped, so that
# a stray symlink cannot quietly widen what the container can reach.
add_dir_mounts() {
	local path="${1}"
	local target="${2}"
	local options="${3:-z}"
	local root entry real rel

	root=$(resolve_host_path "$path") || return 0
	[[ -d "$root" ]] || return 0

	# directories are excluded, but symlinks to them are mounted as they are
	while IFS= read -r -d '' entry; do
		rel="${entry#"$root"/}"

		if ! real=$(resolve_host_path "$entry"); then
			echo "Skipping ${entry}: unresolvable symlink" >&2
			continue
		fi
		if [[ "$real" != "$root"/* && "$real" != "$HOME"/* ]]; then
			echo "Skipping ${entry}: resolves outside of ${root} and HOME" >&2
			continue
		fi

		add_mount "$real" "$target/$rel" "$options"
	done < <(find "$root" -mindepth 1 ! -type d -print0)
}

# Collect the mounts exposing the host's git configuration
#
# Read-only throughout, on purpose: a container able to write here could plant
# symlinks that widen these mounts on the next run.
collect_git_config() {
	local before=${#MOUNT_ARGS[@]}

	# git reads this location in addition to the one below
	if [[ -e "$HOME/.gitconfig" ]]; then
		add_mount "$HOME/.gitconfig" "/root/.gitconfig" "ro,z"
	fi
	add_dir_mounts "${XDG_CONFIG_HOME:-$HOME/.config}/git" "/root/.config/git" "ro,z"

	if [[ ${#MOUNT_ARGS[@]} -eq $before ]]; then
		echo "Warning: no git config found, commits will lack an author identity" >&2
	fi
}

# Collect the mounts exposing the unified claude-container directory
#
# The whole directory is mounted rw so that anything Claude writes anywhere
# under /root/.claude persists (state directories included - no new mount
# code needed when Claude grows one). On top of it, the instruction and
# executable trees are re-mounted ro: a container able to write there could
# plant rules, agents, or hooks that the next session loads.
collect_claude_mounts() {
	add_mount "$CC_DIR" "/root/.claude" "rw,z"
	add_mount "$CC_DIR/claude.json" "/root/.claude.json" "rw,z"

	local ro_dirs=(
		"rules"
		"agents"
		"hooks"
		"themes"
		"output-styles"
		"workflows"
		"commands"
	)
	for d in "${ro_dirs[@]}"; do
		if [[ -d "$CC_DIR/$d" ]]; then
			add_mount "$CC_DIR/$d" "/root/.claude/$d" "ro,z"
		fi
	done
}

# Collect external skills from configuration file, env vars, and CLI arguments
collect_skills_mounts() {
	local skill_sources=()

	# 1. Load from skills.conf if present in CC_DIR
	if [[ -f "$CC_DIR/skills.conf" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			# Strip comments and empty lines
			line="${line%%#*}"
			line="$(echo "$line" | xargs)" # trim whitespace
			[[ -z "$line" ]] && continue
			skill_sources+=("$line")
		done <"$CC_DIR/skills.conf"
	fi

	# 2. Add CLAUDE_SKILLS_DIR from environment if defined
	if [[ -n "${CLAUDE_SKILLS_DIR:-}" ]]; then
		IFS=: read -ra env_dirs <<<"$CLAUDE_SKILLS_DIR"
		skill_sources+=("${env_dirs[@]}")
	fi

	# 3. Add command-line specified skills directories
	skill_sources+=("${EXTRA_SKILLS_DIRS[@]}")

	# Mount individual skills from each source directory
	local src resolved_src skill_dir skill_name
	for src in "${skill_sources[@]}"; do
		# Expand ~ if present
		src="${src/#\~/$HOME}"
		resolved_src=$(resolve_host_path "$src") || {
			echo "Skipping skill directory ${src}: path does not exist" >&2
			continue
		}
		[[ -d "$resolved_src" ]] || continue

		# If the directory itself contains a SKILL.md, it is a single skill
		if [[ -f "$resolved_src/SKILL.md" ]]; then
			skill_name=$(basename "$resolved_src")
			add_mount "$resolved_src" "/root/.claude/skills/$skill_name" "ro,z"
		else
			# Otherwise, inspect subdirectories for SKILL.md or bundle directories
			for skill_dir in "$resolved_src"/*; do
				[[ -d "$skill_dir" ]] || continue
				skill_name=$(basename "$skill_dir")
				add_mount "$skill_dir" "/root/.claude/skills/$skill_name" "ro,z"
			done
		fi
	done
}

# Collect the mounts requested on the command line with -m/--mount
#
# Each entry uses the podman -v syntax, <from>:<to>[:<options>]. Sources go
# through the same resolution as the git config mounts, so that a symlink is
# mounted as whatever it points at, while the target keeps the path as given.
#
# A directory is mounted as a single directory rather than expanded entry by
# entry the way collect_git_config does it. That expansion exists to keep
# stow style symlink farms usable, and applying it here would turn a mount of
# a pseudo filesystem such as /sys/fs/selinux into hundreds of mounts of its
# individual attribute files.
#
# Options are passed through untouched, which matters for sources that cannot
# be relabelled: selinuxfs rejects the chcon behind z, so mounting it needs a
# bare ro rather than the default.
collect_mounts() {
	local spec from to options extra

	for spec in "${MOUNTS[@]}"; do
		IFS=: read -r from to options extra <<<"$spec"

		if [[ -n "$extra" ]]; then
			echo "Skipping ${spec}: expected <from>:<to>[:<options>]" >&2
			continue
		fi
		if [[ -z "$from" ]]; then
			echo "Skipping ${spec}: no source path" >&2
			continue
		fi

		# a lone source is mounted at the same path inside the container
		if [[ -z "$to" ]]; then
			if ! to=$(resolve_host_path "$from"); then
				echo "Skipping ${spec}: unresolvable source ${from}" >&2
				continue
			fi
		fi

		# podman only accepts absolute paths as a mount target
		if [[ "$to" != /* ]]; then
			echo "Skipping ${spec}: target ${to} is not absolute" >&2
			continue
		fi

		add_mount "$from" "$to" "${options:-z}"
	done
}

ensure_selinux_policy() {
	# If SELinux is not active/enforcing or semodule/sesearch are unavailable, nothing to do
	command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled || return 0

	# Check if the policy rule is already active
	if command -v sesearch >/dev/null 2>&1; then
		if sesearch -A -s container_t -t unconfined_t -c unix_stream_socket -p connectto 2>/dev/null | grep -q connectto; then
			return 0
		fi
	elif command -v semodule >/dev/null 2>&1; then
		if semodule -l 2>/dev/null | grep -q "^container_ssh_forward\b"; then
			return 0
		fi
	fi

	# Write CIL module to a securely created temporary directory inside RUNTIME_DIR
	local tmp_dir
	tmp_dir=$(mktemp -d "${RUNTIME_DIR}/selinux-policy.XXXXXX")
	local module_file="${tmp_dir}/container_ssh_forward.cil"

	cat <<'EOF' >"$module_file"
(allow container_t unconfined_t (unix_stream_socket (connectto)))
EOF

	# Policy rule is missing; install module using sudo or doas if available
	echo "Installing required SELinux policy module for SSH agent forwarding..." >&2
	local install_err=0
	if [[ $EUID -eq 0 ]]; then
		semodule -i "$module_file" || install_err=$?
	elif command -v sudo >/dev/null 2>&1; then
		sudo semodule -i "$module_file" || install_err=$?
	elif command -v doas >/dev/null 2>&1; then
		doas semodule -i "$module_file" || install_err=$?
	else
		echo "Warning: Unable to install SELinux policy module (sudo/doas not found). Please run:
    echo '(allow container_t unconfined_t (unix_stream_socket (connectto)))' | sudo semodule -i /dev/stdin" >&2
		install_err=1
	fi

	rm -rf "$tmp_dir"
	return $install_err
}

create_ssh_sock() {
	# only run this if an SSH_AUTH_SOCK is defined
	if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
		ensure_selinux_policy

		# Creates UNIX socket to mount into container that forwards traffic to SSH agent.
		socat "UNIX-LISTEN:$RUNTIME_DIR/agent.sock,mode=777,fork" "UNIX-CLIENT:$SSH_AUTH_SOCK" &>/dev/null &
		SOCAT_PID=$!

		# wait for socat to successfully create the socket
		while [[ ! -S "$RUNTIME_DIR/agent.sock" ]]; do
			sleep 0.1
		done

		# relabel so the container (container_t) can access the socket file. The :Z mount
		# option does not relabel a live unix socket, so do it here explicitly.
		chcon -t container_file_t "$RUNTIME_DIR/agent.sock" 2>/dev/null || true
	fi
}

run_claude() {
	SSH_ARGS=()
	# only add ssh args if an SSH_AUTH_SOCK is defined
	if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
		SSH_ARGS+=(-v "$HOME/.ssh/known_hosts:/etc/ssh/ssh_known_hosts:ro,z")
		SSH_ARGS+=(-v "$RUNTIME_DIR/agent.sock:/root/.ssh/agent.sock:z")
		SSH_ARGS+=(-e "SSH_AUTH_SOCK=/root/.ssh/agent.sock")
	fi

	podman run -it --rm \
		-w "$DIR" \
		-v "$DIR:$DIR:z" \
		"${SSH_ARGS[@]}" \
		"${MOUNT_ARGS[@]}" \
		"${CONTAINER_ARGS[@]}" \
		"docker.io/hyprhvn/claude-container:$CONTAINER_TAG" \
		"${CLAUDE_ARGS[@]}"
}

main() {
	ensure_locations
	collect_git_config
	collect_claude_mounts
	collect_skills_mounts
	collect_mounts
	create_ssh_sock
	run_claude
}

# only run this if executed as a script, not if sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	get_opts "${@}"
	main
	exit 0
fi
